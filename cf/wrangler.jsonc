{
	"name": "ks-ssh-v2",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	"assets": { "directory": "./dist/client", "not_found_handling": "single-page-application" },
	"durable_objects": {
		"bindings": [{ "name": "TUNNEL", "class_name": "TunnelRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelRoom"] }],
	"observability": {
		"enabled": true
	}
}
